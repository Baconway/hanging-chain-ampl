# ==============================================================================
# Kịch bản thực thi: xich_chuong_ngai_vat.run
# Bài tập 4: Bài toán dây xích treo (Thực thi Câu 3 & Khảo sát bộ thông số tùy chọn)
# ==============================================================================

reset;

# Nạp mô hình và dữ liệu cơ sở
model xich_chuong_ngai_vat.mod;
data xich_chuong_ngai_vat.dat;

# Thiết lập điểm khởi tạo theo yêu cầu của Bài tập 4, Câu 3:
# x_k = y_k = -1 với mọi k = 1, ..., m
let {k in 1..so_mat_xich} x[k] := -1.0;
let {k in 1..so_mat_xich} y[k] := -1.0;

# Cấu hình bộ giải
option solver ipopt;

# ------------------------------------------------------------------------------
# 1. CHẠY CƠ SỞ: chieu_cao_h = 1.5, tam_mu = 1.0, phuong_sai = 0.1, do_dich_nu = 2.0
# ------------------------------------------------------------------------------
printf "\n==================================================================\n";
printf "   CÂU 3: CHẠY CƠ SỞ (DÂY XÍCH 10 MẮT XÍCH CÓ CHƯỚNG NGẠI VẬT)   \n";
printf "==================================================================\n";

solve;

printf "Trạng thái giải cơ sở: %s\n", solve_result;
printf "Thế năng tối ưu cơ sở: %12.6f\n\n", TheNang;

printf "Tọa độ các khớp nối ở cấu hình cơ sở (X_k, Y_k):\n";
printf "%-6s %12s %12s\n", "Khớp", "X", "Y";
for {k in 0..so_mat_xich} {
    printf "%-6d %12.6f %12.6f\n", k, toa_do_khop_x[k], toa_do_khop_y[k];
}

printf "\nKiểm tra các điểm tiếp xúc với chướng ngại vật (khoảng cách < 1e-3):\n";
printf "%-6s %-6s %12s %12s %14s %14s\n", "k", "i", "diem_x", "diem_y", "ChuongNgai(x)", "KhoangCach";
for {k in 1..so_mat_xich, i in 0..so_diem_chia} {
    if abs(diem_chia_y[k,i] - (chieu_cao_h * exp(-(diem_chia_x[k,i] - tam_mu)^2 / phuong_sai) - do_dich_nu)) < 1e-3 then {
        printf "%-6d %-6d %12.6f %12.6f %14.6f %14.6e\n",
            k, i, diem_chia_x[k,i], diem_chia_y[k,i],
            chieu_cao_h * exp(-(diem_chia_x[k,i] - tam_mu)^2 / phuong_sai) - do_dich_nu,
            diem_chia_y[k,i] - (chieu_cao_h * exp(-(diem_chia_x[k,i] - tam_mu)^2 / phuong_sai) - do_dich_nu);
    }
}

# Xuất kết quả cơ sở ra tệp văn bản
printf "# Khop X Y\n" > toa_do_xich_chuong_ngai_co_so.txt;
for {k in 0..so_mat_xich} {
    printf "%d %12.6f %12.6f\n", k, toa_do_khop_x[k], toa_do_khop_y[k] >> toa_do_xich_chuong_ngai_co_so.txt;
}
printf "\nĐã xuất tọa độ khớp nối cơ sở ra tệp 'toa_do_xich_chuong_ngai_co_so.txt'.\n";

# ------------------------------------------------------------------------------
# 2. KHẢO SÁT THÔNG SỐ TÙY CHỌN: Chướng ngại vật lệch tâm (tam_mu = 1.3, chieu_cao_h = 1.6)
# Minh họa sự biến dạng của dây xích khi đỉnh chướng ngại vật dịch sang bên phải
# ------------------------------------------------------------------------------
printf "\n==================================================================\n";
printf "   CÂU 3: CHẠY TÙY CHỌN (CHƯỚNG NGẠI VẬT LỆCH TÂM: tam_mu = 1.3)  \n";
printf "==================================================================\n";

# Thay đổi thông số cho kịch bản tùy chọn
let tam_mu := 1.3;
let chieu_cao_h := 1.6;

# Đặt lại điểm khởi tạo
let {k in 1..so_mat_xich} x[k] := -1.0;
let {k in 1..so_mat_xich} y[k] := -1.0;

solve;

printf "Trạng thái giải tùy chọn: %s\n", solve_result;
printf "Thế năng tối ưu tùy chọn: %12.6f\n\n", TheNang;

printf "Tọa độ các khớp nối ở cấu hình tùy chọn (X_k, Y_k):\n";
printf "%-6s %12s %12s\n", "Khớp", "X", "Y";
for {k in 0..so_mat_xich} {
    printf "%-6d %12.6f %12.6f\n", k, toa_do_khop_x[k], toa_do_khop_y[k];
}

# Xuất kết quả tùy chọn ra tệp văn bản
printf "# Khop X Y\n" > toa_do_xich_chuong_ngai_tuy_chon.txt;
for {k in 0..so_mat_xich} {
    printf "%d %12.6f %12.6f\n", k, toa_do_khop_x[k], toa_do_khop_y[k] >> toa_do_xich_chuong_ngai_tuy_chon.txt;
}
printf "\nĐã xuất tọa độ khớp nối tùy chọn ra tệp 'toa_do_xich_chuong_ngai_tuy_chon.txt'.\n";

