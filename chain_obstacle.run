# ==============================================================================
# Run Script: chain_obstacle.run
# Exercise 4: The Hanging Chain Problem (Question 3 Execution & Parameter Study)
# ==============================================================================

reset;

# Load model and baseline data
model chain_obstacle.mod;
data chain_obstacle.dat;

# Specify starting points as required by Exercise 4, Question 3:
# x_k = y_k = -1 for all k = 1, ..., m
let {k in 1..m} x[k] := -1.0;
let {k in 1..m} y[k] := -1.0;

# Solver configuration
option solver ipopt;

# ------------------------------------------------------------------------------
# 1. BASELINE RUN: h = 1.5, mu = 1.0, sigmasquare = 0.1, nu = 2.0
# ------------------------------------------------------------------------------
printf "\n==================================================================\n";
printf "     QUESTION 3: BASELINE RUN (10-LINK CHAIN WITH OBSTACLE)       \n";
printf "==================================================================\n";

solve;

printf "Baseline Solve Status: %s\n", solve_result;
printf "Baseline Potential Energy: %12.6f\n\n", PotentialEnergy;

printf "Baseline Node Coordinates (X_k, Y_k):\n";
printf "%-6s %12s %12s\n", "Node", "X", "Y";
for {k in 0..m} {
    printf "%-6d %12.6f %12.6f\n", k, lx[k], ly[k];
}

printf "\nChecking Contact with Obstacle (gap < 1e-3):\n";
printf "%-6s %-6s %12s %12s %14s %14s\n", "k", "i", "cx", "cy", "Obstacle(cx)", "Gap (cy-obst)";
for {k in 1..m, i in 0..n} {
    if abs(cy[k,i] - (h * exp(-(cx[k,i]-mu)^2/sigmasquare) - nu)) < 1e-3 then {
        printf "%-6d %-6d %12.6f %12.6f %14.6f %14.6e\n",
            k, i, cx[k,i], cy[k,i],
            h * exp(-(cx[k,i]-mu)^2/sigmasquare) - nu,
            cy[k,i] - (h * exp(-(cx[k,i]-mu)^2/sigmasquare) - nu);
    }
}

# Export baseline results
printf "# Node X Y\n" > chain_obstacle_baseline_nodes.txt;
for {k in 0..m} {
    printf "%d %12.6f %12.6f\n", k, lx[k], ly[k] >> chain_obstacle_baseline_nodes.txt;
}
printf "\nBaseline node coordinates exported to 'chain_obstacle_baseline_nodes.txt'.\n";

# ------------------------------------------------------------------------------
# 2. CUSTOM PARAMETER STUDY: Asymmetric Obstacle (mu = 1.3, h = 1.6)
# Demonstrates chain deformation under an off-center obstacle
# ------------------------------------------------------------------------------
printf "\n==================================================================\n";
printf "     QUESTION 3: CUSTOM RUN (ASYMMETRIC OBSTACLE: mu = 1.3)       \n";
printf "==================================================================\n";

# Modify parameters for custom scenario
let mu := 1.3;
let h := 1.6;

# Re-initialize starting point
let {k in 1..m} x[k] := -1.0;
let {k in 1..m} y[k] := -1.0;

solve;

printf "Custom Solve Status: %s\n", solve_result;
printf "Custom Potential Energy: %12.6f\n\n", PotentialEnergy;

printf "Custom Node Coordinates (X_k, Y_k):\n";
printf "%-6s %12s %12s\n", "Node", "X", "Y";
for {k in 0..m} {
    printf "%-6d %12.6f %12.6f\n", k, lx[k], ly[k];
}

# Export custom results
printf "# Node X Y\n" > chain_obstacle_custom_nodes.txt;
for {k in 0..m} {
    printf "%d %12.6f %12.6f\n", k, lx[k], ly[k] >> chain_obstacle_custom_nodes.txt;
}
printf "\nCustom node coordinates exported to 'chain_obstacle_custom_nodes.txt'.\n";

