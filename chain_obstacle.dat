# Chain parameters:
param m := 10;
param L := 3.0;
param a := 2.0;
param b := 0.0;

# Obstacle parameters: obst(x) = h * exp( - (x - mu)^2 / sigmasquare ) - nu
param h := 1.5;
param mu := 1.0;
param sigmasquare := 0.1;
param nu := 2.0;

# Number of discretization intervals per link
param n := 20;

